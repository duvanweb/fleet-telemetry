APP_ENV=development

# Vehicle Service (port 8081)
VEHICLE_HTTP_PORT=8081
VEHICLE_DATABASE_URL=postgres://fleet:fleet@localhost:5432/vehicle_db?sslmode=disable
VEHICLE_RABBITMQ_URL=amqp://fleet:fleet@localhost:5672/

# Telemetry Service (port 8082)
TELEMETRY_HTTP_PORT=8082
TELEMETRY_DATABASE_URL=postgres://fleet:fleet@localhost:5432/telemetry_db?sslmode=disable
TELEMETRY_REDIS_URL=redis://localhost:6379
TELEMETRY_RABBITMQ_URL=amqp://fleet:fleet@localhost:5672/
TELEMETRY_DEDUP_TTL=60s
TELEMETRY_LAST_POSITION_TTL=10m
TELEMETRY_VEHICLE_SERVICE_URL=http://localhost:8081

# Alert Service (port 8083)
ALERT_HTTP_PORT=8083
ALERT_DATABASE_URL=postgres://fleet:fleet@localhost:5432/alert_db?sslmode=disable
ALERT_RABBITMQ_URL=amqp://fleet:fleet@localhost:5672/
ALERT_STOPPED_THRESHOLD=1m

# Simulator (port 8090)
SIMULATOR_HTTP_PORT=8090
SIMULATOR_TELEMETRY_SERVICE_URL=http://localhost:8082

# Circuit breaker
CB_MAX_REQUESTS=1
CB_INTERVAL=60s
CB_TIMEOUT=30s
CB_FAILURE_THRESHOLD=5

LOG_LEVEL=info
